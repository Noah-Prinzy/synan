{
  "name": "synan",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:attendee": "pnpm --filter @synan/attendee dev",
    "dev:admin": "pnpm --filter @synan/admin dev",
    "dev:scanner": "pnpm --filter @synan/scanner dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "e2e": "pnpm --filter @synan/e2e test",
    "e2e:headed": "pnpm --filter @synan/e2e test:headed",
    "e2e:report": "pnpm --filter @synan/e2e report"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
