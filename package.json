{
  "name": "synan",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "//": "PROVISIONAL (CI, step 5.1): test:realpg, db:migrate:check and db:migrations:verify are minimal versions written with the CI workflow; another engineer is writing the same commands. Keep one implementation of each at merge (see scripts/db/ and scripts/run-suite.mjs).",
  "scripts": {
    "dev:attendee": "pnpm --filter @synan/attendee dev",
    "dev:admin": "pnpm --filter @synan/admin dev",
    "dev:scanner": "pnpm --filter @synan/scanner dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "check": "node scripts/check.mjs",
    "test:suite": "node scripts/run-suite.mjs",
    "test:counts": "node scripts/test-counts.mjs check",
    "test:realpg": "node scripts/run-suite.mjs realpg-db realpg-api",
    "db:migrate:check": "node scripts/lib/pnpm.mjs --filter @synan/db exec tsx ../../scripts/db/migrate-check.mts",
    "db:migrations:verify": "node scripts/db/migrations-verify.mjs",
    "build:apps": "node scripts/lib/pnpm.mjs --filter @synan/attendee --filter @synan/admin --filter @synan/scanner run build --manifest",
    "budget": "node scripts/bundle-budget.mjs",
    "hygiene": "node scripts/hygiene.mjs && node scripts/check-links.mjs",
    "audit:deps": "node scripts/audit.mjs",
    "e2e": "pnpm --filter @synan/e2e test",
    "e2e:headed": "pnpm --filter @synan/e2e test:headed",
    "e2e:report": "pnpm --filter @synan/e2e report"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
