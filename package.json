{
  "name": "synan",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "//": "Scripts that call pnpm go through scripts/lib/pnpm.mjs, so they work where pnpm is reached only through corepack (not on PATH) as well as in CI.",
  "scripts": {
    "dev:attendee": "node scripts/lib/pnpm.mjs --filter @synan/attendee dev",
    "dev:admin": "node scripts/lib/pnpm.mjs --filter @synan/admin dev",
    "dev:scanner": "node scripts/lib/pnpm.mjs --filter @synan/scanner dev",
    "build": "node scripts/lib/pnpm.mjs -r build",
    "typecheck": "node scripts/lib/pnpm.mjs -r typecheck",
    "check": "node scripts/check.mjs",
    "test:suite": "node scripts/run-suite.mjs",
    "test:counts": "node scripts/test-counts.mjs check",
    "test:realpg": "node scripts/with-pg.mjs node scripts/run-suite.mjs realpg-db realpg-api",
    "pg:start": "node scripts/pg-start.mjs",
    "pg:stop": "node scripts/pg-stop.mjs",
    "pg:status": "node scripts/pg-status.mjs",
    "db:migrate:check": "node scripts/with-pg.mjs pnpm --filter @synan/db migrate:check",
    "db:migrations:verify": "node scripts/lib/pnpm.mjs --filter @synan/db migrations:verify",
    "db:migrations:manifest": "node scripts/lib/pnpm.mjs --filter @synan/db migrations:manifest",
    "db:seed:load": "node scripts/with-pg.mjs pnpm --filter @synan/api seed:load",
    "load:scans": "node scripts/load-scans.mjs",
    "build:apps": "node scripts/lib/pnpm.mjs --filter @synan/attendee --filter @synan/admin --filter @synan/scanner run build --manifest",
    "budget": "node scripts/bundle-budget.mjs",
    "hygiene": "node scripts/hygiene.mjs && node scripts/check-links.mjs && node scripts/check-theme-utilities.mjs",
    "audit:deps": "node scripts/audit.mjs",
    "e2e": "node scripts/lib/pnpm.mjs --filter @synan/e2e test",
    "e2e:headed": "node scripts/lib/pnpm.mjs --filter @synan/e2e test:headed",
    "e2e:report": "node scripts/lib/pnpm.mjs --filter @synan/e2e report"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
