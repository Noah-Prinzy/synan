# Copy to apps/api/.env for local overrides. Never commit .env.
# Everything here is optional in development: missing keys are generated at startup.

PORT=5180
HOST=127.0.0.1
# Comma-separated origins allowed for CORS and WebSocket upgrades.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Where attendee sign-in links point.
ATTENDEE_APP_ORIGIN=http://localhost:5173

# Repository backend:
#   memory   in-process maps; stores nothing at rest and does NOT encrypt (dev, fast tests)
#   pglite   in-process PostgreSQL with every @synan/db migration (dev, tests)
#   postgres PostgreSQL through node-postgres with the role split. The only backend allowed in production.
REPO=memory
# PGlite data directory; empty = in-memory database, lost on exit.
PGLITE_DATA_DIR=

# REPO=postgres: one login per role (@synan/db migration 0005). Production requires all three, and the
# API refuses to start unless each connects as exactly its role and none bypasses row-level security.
# Login in app_api: operational tables.
DATABASE_URL=
# Login in app_vault: reading identity, erasure.
DATABASE_VAULT_URL=
# Login in app_scan: scan ingest's ephemeral-ID mapping.
DATABASE_SCAN_URL=

# Field encryption (@synan/db crypto). Required in production; when empty, PGlite and tests use the fixed
# development keys, which @synan/db refuses under NODE_ENV=production. Generate keys with
# generateKeyMaterial() (32 random bytes, base64).
# kid:base64,kid:base64 — every AES-256 key still in use.
DB_DATA_KEYS=
# kid for new encryptions (default: last listed).
DB_DATA_KEY_ACTIVE=
# Email blind index. Migrating from the old EMAIL_INDEX_KEY: keep it as a legacy entry so existing
# hashes still match, add a new key, make it active, then run `secrets:maintain` to re-index:
#   DB_BLIND_INDEX_KEYS=legacy:utf8:<old EMAIL_INDEX_KEY>,bi1:<base64 32 bytes>
DB_BLIND_INDEX_KEYS=
DB_BLIND_INDEX_KEY_ACTIVE=

# Ed25519 private JWK (JSON, one line) for access tokens. Generated per start when empty,
# which signs everyone out on restart. Required in production.
ACCESS_TOKEN_PRIVATE_JWK=

ACCESS_TOKEN_TTL_S=600
OPERATOR_REFRESH_TTL_S=43200
ATTENDEE_REFRESH_TTL_S=2592000
MFA_FRESH_S=900
EMAIL_LINK_TTL_S=900

# Portal QR (O-07, pending security review): code validity and batch size.
QR_CODE_TTL_S=60
QR_BATCH_SIZE=15
# Integer seconds, 0-30. Startup fails on a malformed or out-of-range value.
QR_LEEWAY_S=5
# Public telemetry k-anonymity threshold (O-08).
K_ANON=5
# How long after a shift ends its scanner may still sync offline scans taken during the shift.
OFFLINE_SYNC_GRACE_S=3600

RATE_AUTH_PER_MIN=10
RATE_SCAN_PER_MIN=600
RATE_RESEND_PER_HOUR=5

# scrypt cost (log2 N). 15 is the dev default; use >= 17 in production.
SCRYPT_LOG_N=15
# console (dev) or memory. A real provider (O-13) plugs in behind src/lib/mailer.ts.
MAIL_TRANSPORT=console
# MAIL_TRANSPORT=console is refused when NODE_ENV=production.
# Dev seed is OPT-IN: only SEED=dev (or --seed=dev, which the dev scripts pass) creates the demo accounts,
# whose password is DEV_SEED_PASSWORD or a default published in this repo. Refused when NODE_ENV=production.
DEV_SEED_PASSWORD=
SEED=none
# Reverse proxies in front of the API: 0 (none, the default), a hop count (e.g. 1 for one TLS proxy),
# or a comma list of proxy IPs/CIDRs. Never 'true': that trusts any client-supplied X-Forwarded-For.
TRUST_PROXY=0

# Report exports: absolute origin for signed download links, local storage directory, link lifetime (s).
API_PUBLIC_ORIGIN=http://127.0.0.1:5180
REPORT_STORAGE_DIR=
REPORT_LINK_TTL_S=600
