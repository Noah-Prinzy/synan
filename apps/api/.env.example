# Copy to apps/api/.env for local overrides. Never commit .env.
# Everything here is optional in development: missing keys are generated at startup.

PORT=5180
HOST=127.0.0.1
# Comma-separated origins allowed for CORS and WebSocket upgrades.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Where attendee sign-in links point.
ATTENDEE_APP_ORIGIN=http://localhost:5173

# Repository backend: memory (default) or pglite (in-process PostgreSQL with @synan/db migrations).
REPO=memory
# PGlite data directory; empty = in-memory database, lost on exit.
PGLITE_DATA_DIR=

# Ed25519 private JWK (JSON, one line) for access tokens. Generated per start when empty,
# which signs everyone out on restart. Required in production.
ACCESS_TOKEN_PRIVATE_JWK=
# HMAC key for the attendee email blind index. Must be stable once data exists. Required in production.
EMAIL_INDEX_KEY=

ACCESS_TOKEN_TTL_S=600
OPERATOR_REFRESH_TTL_S=43200
ATTENDEE_REFRESH_TTL_S=2592000
MFA_FRESH_S=900
EMAIL_LINK_TTL_S=900

# Portal QR (O-07, pending security review): code validity and batch size.
QR_CODE_TTL_S=60
QR_BATCH_SIZE=15
QR_LEEWAY_S=5
# Public telemetry k-anonymity threshold (O-08).
K_ANON=5

RATE_AUTH_PER_MIN=10
RATE_SCAN_PER_MIN=600
RATE_RESEND_PER_HOUR=5

# scrypt cost (log2 N). 15 is the dev default; use >= 17 in production.
SCRYPT_LOG_N=15
# console (dev) or memory. A real provider (O-13) plugs in behind src/lib/mailer.ts.
MAIL_TRANSPORT=console
# Dev seed: password for every seeded operator/staff account. Seed refuses to run when NODE_ENV=production.
DEV_SEED_PASSWORD=
SEED=dev
TRUST_PROXY=0
